---
import FramedChrome from './FramedChrome.astro';

const current = Astro.url.pathname.startsWith('/blog') ? 'stories' : Astro.url.pathname === '/about' ? 'about' : undefined;
---

<div class="site-header">
	<FramedChrome current={current} minimal />
</div>

<style>
	.site-header {
		--hero-frame: var(--page-background);
		--hero-line: transparent;
		--hero-gap: 0.75rem;
		--hero-panel-width: 38rem;
		--hero-control-height: 2.25rem;
		--hero-header-height: calc(var(--hero-gap) * 2 + var(--hero-control-height));
		--hero-brand-width: 13.25rem;
		--hero-logo-width: 2.15rem;
		position: relative;
		isolation: isolate;
		height: var(--hero-header-height);
		border: 0 !important;
		background: var(--page-background);
		box-shadow: none;
	}

	@media (max-width: 700px) {
		.site-header {
			--hero-gap: 0.55rem;
			--hero-panel-width: calc(100% - 0.6rem);
			--hero-control-height: 2rem;
			--hero-brand-width: 10.25rem;
			--hero-logo-width-mobile: 1.65rem;
			height: var(--hero-header-height);
		}
	}

	@media (max-width: 420px) {
		.site-header {
			--hero-brand-width: 3.8rem;
		}
	}
</style>
