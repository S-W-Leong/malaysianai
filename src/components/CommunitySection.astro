---
import { ADD_COMMUNITY_HREF, LUMA_URL } from '../consts';

const communities = [
	{
		name: 'Build Club',
		logo: '/build-club-logo-navbar.webp',
		logoClass: 'is-wide',
		label: 'Learn by building',
		description:
			'A large Asia-Pacific builder community with bite-sized courses, role-based learning tracks, and project bounties. A useful place to learn AI by making real things.',
	},
	{
		name: 'Build with AI',
		logo: '/build_with_ai_logo.jpeg',
		logoClass: 'is-square',
		label: 'Open builder meetups',
		description:
			"Malaysia's home for developers and non-technical builders creating AI projects together. Its meetups welcome first-timers and experienced makers alike.",
	},
	{
		name: 'AI Tinkerers',
		logo: '/ai_tinkerers_logo.png',
		logoClass: 'is-wide',
		label: 'Technical deep dives',
		description:
			'The Kuala Lumpur chapter of a global AI engineering network. Monthly meetups put live demos, practical talks, and technical conversation in the same room.',
	},
	{
		name: 'AI Hackerdorm',
		logo: '/ai_hackerdorm.webp',
		logoClass: 'is-square',
		label: 'Student-first builds',
		description:
			'A community for student coders, designers, and founders building AI projects together through weekly sprints, hackathons, and mentorship sessions.',
	},
	{
		name: 'AI SEA',
		logo: '/aisea_logo.png',
		logoClass: 'is-square',
		label: 'Southeast Asian network',
		description:
			'A regional builder network for people shipping AI products. It brings engineers together through hackathons, co-build sprints, and AI.SEA Week.',
	},
	{
		name: 'KrackedDevs',
		logo: '/krackeddevs-logo.png',
		logoClass: 'is-square',
		label: 'Grassroots builder guilds',
		description:
			'A Malaysian builder ecosystem helping technical and non-technical folks become AI builders through guilds, workshops, bounties, and project showcases.',
	},
	{
		name: 'Rakan Tutor',
		logo: '/rakan-tutor-logo.png',
		logoClass: 'is-wide',
		label: 'AI education for all',
		description:
			'A Malaysian non-profit bringing free, hands-on AI education to underserved secondary school students and helping young people prepare for an AI-shaped future.',
	},
	{
		name: 'CoderPuffs',
		logo: '/coderpuffs_logo.png',
		logoClass: 'is-square',
		label: 'Women-first community',
		description:
			'Welcoming café-based build sessions that make coding and AI easier to enter. Its monthly meetups are designed for women at every experience level.',
	},
	{
		name: 'Cursor KL',
		logo: '/cursor-community-logo.png',
		logoClass: 'is-square',
		label: 'Cursor builders in KL',
		description:
			'The Kuala Lumpur community for people building with Cursor. Join local hackathons, workshops, and conversations with other product-minded makers.',
	},
];
---

<section class="community-chapter light-nav-zone" id="communities" aria-labelledby="community-title">
	<div class="community-shell">
		<header class="community-intro">
			<div class="community-heading">
				<h2 id="community-title">Malaysia's AI<br /> Communities and Events.</h2>
			</div>
			<div class="community-copy">
				<p class="community-lede">
					A growing map of AI communities across Malaysia — meetups, builder groups, student
					chapters, and everyone in between. Join an event, find your people, or add your
					community to the list. Many gatherings are free and very welcoming.
				</p>
				<div class="community-actions">
					<a class="site-button" href={LUMA_URL}>View upcoming events</a>
					<a href={ADD_COMMUNITY_HREF}>Add your community</a>
				</div>
			</div>
		</header>

		<ul class="community-grid">
			{
				communities.map((community) => (
					<li>
						<article class="community-card">
							<figure class:list={['community-mark', community.logoClass]}>
								<img
									src={community.logo}
									alt=""
									width="220"
									height="140"
									loading="lazy"
									decoding="async"
								/>
							</figure>
							<div class="community-body">
								<p class="community-label">{community.label}</p>
								<h3>{community.name}</h3>
								<p>{community.description}</p>
							</div>
						</article>
					</li>
				))
			}
		</ul>

		<div class="community-invite">
			<p>
				Run a community that isn't listed yet? We're building this as a shared directory for
				Malaysia's AI scene — filled in by the people who organise it.
			</p>
			<a href={ADD_COMMUNITY_HREF}>Submit a community <span aria-hidden="true">↗</span></a>
		</div>
	</div>
</section>

<style>
	.community-chapter {
		padding: clamp(4rem, 7vw, 6rem) clamp(1.5rem, 4vw, 4rem);
		color: var(--text-bright);
		background: var(--page-background);
	}

	.community-shell {
		display: grid;
		gap: clamp(2.25rem, 4vw, 3.5rem);
		width: min(92rem, 100%);
		margin: 0 auto;
	}

	.community-intro {
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(16rem, 0.85fr);
		gap: clamp(1.5rem, 4vw, 4rem);
		align-items: end;
	}

	.community-heading h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(2.3rem, 3.8vw, 3.6rem);
		font-weight: 400;
		letter-spacing: -0.035em;
		line-height: 0.9;
		text-wrap: balance;
	}

	.community-copy {
		display: grid;
		gap: 1.15rem;
		justify-items: start;
	}

	.community-lede {
		max-width: 28rem;
		margin: 0;
		color: rgb(224 232 244 / 0.72);
		font-size: clamp(0.92rem, 1.25vw, 1.08rem);
		line-height: var(--leading-body);
	}

	.community-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1.1rem;
		align-items: center;
	}

	.community-actions a:not(.site-button),
	.community-invite a {
		color: inherit;
		text-underline-offset: 0.22em;
	}

	.community-actions a:focus-visible,
	.community-invite a:focus-visible {
		outline: 2px solid var(--focus-color);
		outline-offset: 4px;
	}

	.community-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
		counter-reset: room;
	}

	.community-grid > li {
		min-width: 0;
	}

	.community-card {
		display: grid;
		counter-increment: room;
		height: 100%;
		overflow: hidden;
		border: 1.5px solid rgb(115 152 207 / 0.55);
		border-radius: 0.95rem;
		background: #0a111c;
		transition: border-color 180ms ease, transform 180ms ease;
	}

	@media (hover: hover) {
		.community-card:hover {
			border-color: rgb(169 199 239 / 0.9);
			transform: translateY(-2px);
		}
	}

	.community-mark {
		position: relative;
		display: grid;
		margin: 0;
		aspect-ratio: 1.35;
		place-items: center;
		background:
			radial-gradient(circle at 50% 40%, rgb(255 255 255 / 0.9), transparent 62%),
			#e9edf3;
	}

	.community-mark::after {
		position: absolute;
		right: 0.7rem;
		bottom: 0.55rem;
		color: rgb(13 22 34 / 0.38);
		content: counter(room, decimal-leading-zero);
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.08em;
	}

	.community-mark img {
		display: block;
		width: 52%;
		height: 52%;
		object-fit: contain;
	}

	.community-mark.is-wide img {
		width: 74%;
	}

	.community-body {
		display: grid;
		gap: 0.55rem;
		align-content: start;
		min-width: 0;
		padding: 1.15rem 1.2rem 1.3rem;
	}

	.community-label {
		margin: 0;
		color: var(--text-accent);
		font-size: 0.66rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.community-body h3 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.45rem, 1.8vw, 1.75rem);
		font-weight: 400;
		letter-spacing: -0.03em;
		line-height: 1;
	}

	.community-body p:last-child {
		margin: 0;
		color: rgb(224 232 244 / 0.68);
		font-size: 0.92rem;
		line-height: var(--leading-body);
	}

	.community-invite {
		display: grid;
		gap: 0.85rem;
		justify-items: center;
		width: min(36rem, 100%);
		margin: 0 auto;
		text-align: center;
	}

	.community-invite p {
		margin: 0;
		color: rgb(224 232 244 / 0.68);
		font-size: clamp(0.9rem, 1.15vw, 1.02rem);
		line-height: var(--leading-body);
	}

	@media (max-width: 960px) {
		.community-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 700px) {
		.community-chapter {
			padding: 3rem 0.65rem;
		}

		.community-shell {
			gap: 1.75rem;
		}

		.community-intro {
			grid-template-columns: 1fr;
			gap: 1.15rem;
			align-items: start;
		}

		.community-heading h2 {
			font-size: clamp(2.3rem, 10vw, 3.25rem);
		}

		.community-lede {
			max-width: none;
		}

		.community-grid {
			grid-template-columns: 1fr;
			gap: 0.75rem;
		}

		.community-card {
			grid-template-columns: 6.5rem minmax(0, 1fr);
			align-items: stretch;
		}

		.community-mark {
			aspect-ratio: auto;
			min-height: 6.5rem;
		}

		.community-mark img {
			width: 64%;
			height: 64%;
		}

		.community-mark.is-wide img {
			width: 78%;
		}

		.community-mark::after {
			right: 0.4rem;
			bottom: 0.4rem;
			font-size: 0.58rem;
		}

		.community-body {
			gap: 0.4rem;
			padding: 0.9rem 0.95rem 1rem 0.85rem;
		}

		.community-body h3 {
			font-size: 1.35rem;
		}

		.community-body p:last-child {
			font-size: 0.86rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.community-card {
			transition: none;
		}

		.community-card:hover {
			transform: none;
		}
	}
</style>
