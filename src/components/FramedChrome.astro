---
import BrandLockup from './BrandLockup.astro';
import { LUMA_URL } from '../consts';

interface Props {
	home?: boolean;
	current?: 'home' | 'about' | 'residency' | 'residents' | 'apply' | 'stories';
	minimal?: boolean;
}

const { home = false, current, minimal = false } = Astro.props;
const links = [
	{ id: 'about', href: '/about', label: 'About' },
	{ id: 'events', href: home ? '#events' : '/#events', label: 'Events' },
	{ id: 'communities', href: home ? '#communities' : '/#communities', label: 'Communities' },
	{ id: 'residency', href: '/residency', label: 'Residency' },
	{ id: 'stories', href: '/blog', label: 'Stories' },
] as const;
---

<header class:list={['hero-header', { 'is-minimal': minimal }]}>
	<div class="brand-panel" transition:name="site-brand" transition:persist="site-brand">
		<a class="brand-mark" href="/" aria-label="Malaysian AI home">
			<BrandLockup />
		</a>
	</div>

	<nav class="hero-nav" aria-label="Primary navigation">
		{links.map(link => (
			<a href={link.href} aria-current={current === link.id ? 'page' : undefined}>{link.label}</a>
		))}
	</nav>

	<details class="mobile-navigation">
		<summary class="site-button">Menu <span aria-hidden="true">⌄</span></summary>
		<nav aria-label="Mobile navigation">
			{links.map(link => (
				<a href={link.href} aria-current={current === link.id ? 'page' : undefined}>{link.label}</a>
			))}
		</nav>
	</details>
</header>

<div class:list={['hero-cta-panel', { 'is-minimal': minimal }]}>
	<a class="nav-cta site-button" href={LUMA_URL}>Find an event</a>
</div>

<script>
	let navigationController: AbortController | undefined;

	function prepareNavigation() {
		navigationController?.abort();
		navigationController = new AbortController();
		const { signal } = navigationController;

		document.querySelectorAll<HTMLDetailsElement>('.mobile-navigation').forEach(menu => {
			menu.addEventListener('click', event => {
				if ((event.target as Element).closest('a')) menu.open = false;
			}, { signal });
			menu.addEventListener('keydown', event => {
				if (event.key === 'Escape') {
					menu.open = false;
					menu.querySelector('summary')?.focus();
				}
			}, { signal });
			document.addEventListener('click', event => {
				if (!menu.contains(event.target as Node)) menu.open = false;
			}, { signal });
		});
	}

	document.addEventListener('astro:page-load', prepareNavigation);
	document.addEventListener('astro:before-swap', () => navigationController?.abort());
</script>

<style>
	.hero-header {
		position: absolute;
		z-index: 4;
		top: 0;
		left: 0;
		width: var(--hero-panel-width, 29rem);
		height: var(--hero-header-height, 4.25rem);
		pointer-events: none;
	}

	.hero-header::before {
		position: absolute;
		z-index: -1;
		top: 0;
		right: 0;
		bottom: auto;
		left: 0;
		height: var(--hero-header-height, 4.25rem);
		border-bottom-right-radius: var(--hero-radius, 0.95rem);
		background: #06090f;
		background: var(--hero-frame, var(--page-background));
		content: '';
	}

	.brand-panel {
		position: absolute;
		top: 0;
		left: 0;
		display: grid;
		width: var(--hero-brand-width, 12.15rem);
		height: var(--hero-header-height, 4.25rem);
		place-items: center start;
		padding: 0 var(--hero-gap, 1rem);
		background: #06090f;
		background: var(--hero-frame, var(--page-background));
		pointer-events: auto;
	}

	.brand-mark {
		display: inline-flex;
		height: var(--hero-logo-width, 1.95rem);
		width: auto;
		min-width: 0;
		min-height: 0;
		color: var(--text-heading);
	}

	.hero-nav {
		position: absolute;
		top: var(--hero-gap, 1rem);
		right: var(--hero-gap, 1rem);
		left: var(--hero-brand-width, 12.15rem);
		display: flex;
		align-items: center;
		justify-content: flex-start;
		gap: 1.15rem;
		height: var(--hero-control-height, 2.25rem);
		padding: 0 0.5rem 0 1.35rem;
		color: var(--text-heading);
		background: transparent;
		pointer-events: auto;
	}

	.hero-nav a,
	.mobile-navigation a {
		font: 400 0.82rem / 1.2 var(--font-body);
		text-decoration: none;
		white-space: nowrap;
	}

	.hero-nav a:hover,
	.hero-nav a[aria-current='page'],
	.mobile-navigation a:hover,
	.mobile-navigation a[aria-current='page'] {
		text-decoration: underline;
		text-underline-offset: 0.3rem;
	}

	.hero-cta-panel {
		position: absolute;
		z-index: 4;
		top: 0;
		right: 0;
		display: flex;
		align-items: flex-start;
		gap: 0.45rem;
		padding: var(--hero-gap, 1rem);
		height: var(--hero-header-height, 4.25rem);
		border-bottom-left-radius: var(--hero-radius, 0.95rem);
		background: var(--hero-frame, var(--page-background));
	}

	.hero-header.is-minimal::before {
		display: none;
	}

	.nav-cta { position: relative; z-index: 1; height: var(--hero-control-height, 2.25rem); }
	.mobile-navigation { display: none; }
	a:focus-visible { outline: 2px solid var(--focus-color); outline-offset: 3px; }

	@media (max-width: 700px) {
		.hero-header { width: var(--hero-panel-width, calc(100% - 0.6rem)); }
		.hero-nav { display: none; }
		.brand-mark {
			height: var(--hero-logo-width-mobile, 1.55rem);
		}
		.hero-cta-panel {
			top: var(--hero-gap, 0.6rem);
			right: calc(var(--hero-gap, 0.6rem) * 2);
			align-items: center;
			height: var(--hero-control-height, 2rem);
			padding: 0;
			background: transparent;
		}

		.mobile-navigation {
			position: absolute;
			top: var(--hero-gap, 0.6rem);
			left: var(--hero-brand-width, 4.4rem);
			display: block;
			pointer-events: auto;
		}
		.mobile-navigation summary { height: var(--hero-control-height, 2rem); list-style: none; }
		.mobile-navigation summary::-webkit-details-marker { display: none; }
		.mobile-navigation summary span { transition: transform 150ms ease; }
		.mobile-navigation[open] summary span { transform: rotate(180deg); }
		.mobile-navigation nav {
			position: absolute;
			top: calc(100% + 1rem);
			left: 0;
			display: grid;
			gap: 0.25rem;
			width: min(18rem, calc(100vw - var(--hero-brand-width, 4.4rem) - 2rem));
			padding: 0.5rem;
			border: 1px solid var(--hairline);
			border-radius: 0.7rem;
			color: var(--text-bright);
			background: var(--card-raised);
			box-shadow: 0 16px 40px rgb(0 0 0 / 0.45);
		}
		.mobile-navigation a { padding: 0.75rem; }
	}

	@media (max-width: 420px) {
		.hero-header {
			--hero-brand-width: 3.8rem;
			--hero-logo-width-mobile: 1.85rem;
		}
	}
</style>
