---
import { Image } from 'astro:assets';
import heroArt from '../assets/hero-fibonacci.png';
import FramedChrome from './FramedChrome.astro';
---

<div class="hero-shell">
	<div class="hero-media">
		<Image
			class="hero-art"
			src={heroArt}
			format="webp"
			widths={[640, 1024, 1672]}
			sizes="max(100vw, 178svh)"
			quality={85}
			alt=""
			width="1672"
			height="941"
			fetchpriority="high"
			decoding="async"
		/>
		<div class="hero-shade" aria-hidden="true"></div>
	</div>

	<FramedChrome home />

	<section class="hero-stage" aria-labelledby="hero-title">
		<p class="hero-kicker">Malaysian AI</p>
		<h1 id="hero-title">Learn, build and experience<br /> Malaysian AI.</h1>
		<p class="intro">
			Discover Malaysia's AI communities and events — meetups, builder groups, and workshops
			across the country. Find your people, join what's happening, or add your community to
			the list.
		</p>
		<div class="hero-actions">
			<a class="card-link site-button" href="#events">View upcoming events</a>
			<a class="card-secondary" href="#communities">Explore communities</a>
		</div>
		<p class="hero-credit">
			Initiated by <a href="https://500.co">500 Global</a>. Managed by <a href="https://www.aisea.builders/">AI SEA</a>.
		</p>
	</section>
</div>

<style>
	a:focus-visible {
		outline: 2px solid #ffd29a;
		outline-offset: 4px;
	}

	.hero-shell {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		color: #fffdf6;
		--hero-frame: var(--page-background);
		--hero-line: var(--border-color);
		--hero-accent: #315d9f;
		--hero-gap: 1rem;
		--hero-panel-width: 32rem;
		--hero-brand-width: 7.2rem;
		--hero-control-height: 2.25rem;
		--hero-header-height: calc(var(--hero-gap) * 2 + var(--hero-control-height));
		min-height: max(46rem, 100svh);
		padding: var(--hero-gap);
		background: var(--hero-frame);
	}

	.hero-media {
		position: absolute;
		z-index: 0;
		inset: var(--hero-gap);
		overflow: hidden;
		border: 1.5px solid var(--hero-line);
		border-radius: 0.95rem;
		background: var(--image-background);
		animation: media-reveal 1.2s 0.05s cubic-bezier(0.2, 0.75, 0.2, 1) both;
	}

	.hero-art,
	.hero-shade {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.hero-art {
		z-index: 0;
		max-width: none;
		object-fit: cover;
		object-position: center;
		animation: hero-settle 1.8s 0.05s cubic-bezier(0.2, 0.72, 0.2, 1) both;
	}

	.hero-shade {
		z-index: 1;
		background:
			linear-gradient(180deg, rgb(10 13 22 / 0.22), rgb(10 13 22 / 0.18) 28%, rgb(6 10 18 / 0.42) 58%, rgb(9 10 14 / 0.62) 100%),
			radial-gradient(ellipse at 50% 46%, rgb(4 9 20 / 0.38), transparent 62%);
	}

	.hero-stage {
		position: absolute;
		z-index: 2;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		inset: var(--hero-header-height) var(--hero-gap) var(--hero-gap);
		padding: 1.5rem 1.5rem 2.25rem;
		text-align: center;
		animation: panel-arrive 0.8s 0.35s ease-out both;
	}

	.hero-kicker {
		margin: 0 0 1rem;
		color: #fffdf8;
		font-family: var(--font-pixel);
		font-size: clamp(1.05rem, 1.5vw, 1.35rem);
		font-weight: 400;
		letter-spacing: 0.04em;
		line-height: 1;
		text-shadow:
			0 0 7px rgb(255 255 255 / 0.42),
			0 3px 20px rgb(13 32 77 / 0.7);
		animation: soft-rise 0.75s 0.7s ease-out both;
	}

	.hero-stage h1 {
		max-width: 18ch;
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(2.7rem, 6.2vw, 5.1rem);
		font-weight: 400;
		letter-spacing: -0.035em;
		line-height: 0.9;
		text-wrap: balance;
		text-shadow: 0 2px 28px rgb(2 12 13 / 0.45);
		animation: soft-rise 0.7s 0.8s ease-out both;
	}

	.intro {
		max-width: 36rem;
		margin: 1.25rem 0 1.5rem;
		color: rgb(255 255 255 / 0.92);
		font-size: clamp(0.95rem, 1.15vw, 1.15rem);
		line-height: 1.5;
		text-shadow: 0 1px 16px rgb(2 12 13 / 0.55);
		animation: soft-rise 0.7s 0.9s ease-out both;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1.1rem;
		align-items: center;
		justify-content: center;
	}

	.card-link {
		width: fit-content;
		transition: background 180ms ease, transform 180ms ease;
		animation: soft-rise 0.65s 1s ease-out both;
	}

	.card-link:hover,
	.card-link:focus-visible {
		transform: translateY(-2px);
	}

	.card-secondary {
		color: rgb(255 255 255 / 0.92);
		font-size: 0.92rem;
		text-underline-offset: 0.22em;
		animation: soft-rise 0.65s 1.05s ease-out both;
	}

	.hero-credit {
		margin: 1.6rem 0 0;
		color: rgb(255 253 248 / 0.72);
		font-size: 0.7rem;
		letter-spacing: 0.16em;
		line-height: 1.6;
		text-transform: uppercase;
		animation: soft-rise 0.65s 1.1s ease-out both;
	}

	.hero-credit a {
		color: inherit;
		text-underline-offset: 0.22em;
	}

	@keyframes soft-rise {
		from {
			opacity: 0;
			transform: translateY(0.55rem);
		}
	}

	@keyframes panel-arrive {
		from {
			opacity: 0;
			transform: translateY(0.7rem);
		}
	}

	@keyframes media-reveal {
		from {
			opacity: 0;
			clip-path: inset(2.5% 2.5% 2.5% 2.5% round 1.2rem);
		}
	}

	@keyframes hero-settle {
		from {
			opacity: 0.72;
			transform: scale(1.025);
		}
	}

	@media (max-width: 700px) {
		.hero-shell {
			--hero-gap: 0.6rem;
			--hero-panel-width: calc(100% - var(--hero-gap));
			--hero-brand-width: 4.4rem;
			--hero-control-height: 2rem;
			min-height: max(42rem, 100svh);
			padding: var(--hero-gap);
		}

		.hero-media {
			inset: var(--hero-gap);
			border-radius: 0.75rem;
		}

		.hero-art {
			object-position: 51% center;
		}

		.hero-stage {
			padding: 1.15rem 1rem 1.5rem;
		}

		.hero-stage h1 {
			max-width: none;
			font-size: clamp(2.2rem, 10vw, 3rem);
			line-height: 0.9;
		}

		.intro {
			max-width: 24rem;
			margin: 0.95rem 0 1.15rem;
			font-size: 0.86rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-media,
		.hero-stage,
		.hero-kicker,
		.hero-stage h1,
		.intro,
		.card-link,
		.card-secondary,
		.hero-credit,
		.hero-art {
			animation: none;
		}
	}
</style>
