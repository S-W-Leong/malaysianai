---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	src: ImageMetadata;
	alt: string;
	fullSrc: string;
}

const { src, alt, fullSrc } = Astro.props;
---

<Image
	src={src}
	alt={alt}
	data-full-image={fullSrc}
	widths={[400, 640, 960, 1280, 1900]}
	sizes="(max-width: 66rem) calc(100vw - 2.5rem), 54rem"
	format="webp"
	quality={85}
	loading="lazy"
	decoding="async"
/>
